# Kline interval
KLINE_INTERVAL=5m

# Parquet archive directory (must be accessible to duckport-rs server)
PARQUET_DIR=$HOME/.duckport/data/pqt

# Data sources (comma-separated: usdt_perp, usdt_spot)
DATA_SOURCES=usdt_perp,usdt_spot

# Concurrency (affects WS listener group count and fetch parallelism)
CONCURRENCY=2

# Keep each Arrow Flight data message below duckport-rs / tonic 64 MiB limit.
# Lower this if the server is configured with a smaller max decode message size.
DUCKPORT_APPEND_MAX_MESSAGE_BYTES=50331648

# Optional status timeout override for data.watermark.
# Default is max(900, KLINE_INTERVAL * 2) seconds.
# WATERMARK_MAX_LAG_SECONDS=1800

# Stream historical Parquet imports instead of loading a whole file into memory.
LOADHIST_BATCH_ROWS=50000
LOADHIST_DUCKDB_THREADS=1
# Optional DuckDB cap for small cloud servers, e.g. 1GB or 512MB.
# LOADHIST_DUCKDB_MEMORY_LIMIT=1GB

# Start date for historical data
START_DATE=2024-01-01

# Historical file download temporary directory
RESOURCE_PATH=$HOME/.duckport/data/hist

# HTTP proxy for Binance API (leave empty if not needed)
PROXY_URL=

# Enable WebSocket mode (true/false)
ENABLE_WS=false
